{
  "manifest_version": 3,
  "name": "CYBER BINARY — Quotex Signal Lab",
  "version": "1.0.0",
  "description": "Chart-attached confluence signals and a live performance dashboard for Quotex. Educational analysis only — not financial advice.",
  "permissions": ["storage", "windows", "tabs", "scripting"],
  "host_permissions": [
    "https://qxbroker.com/*",
    "https://quotex.com/*",
    "https://*.quotex.com/*",
    "https://*.qxbroker.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "CYBER BINARY",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://qxbroker.com/*",
        "https://quotex.com/*",
        "https://*.quotex.com/*",
        "https://*.qxbroker.com/*"
      ],
      "js": [
        "src/lib/indicators.js",
        "src/lib/engine.js",
        "src/content.js"
      ],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/dashboard.html", "src/dashboard.css", "src/dashboard.js", "src/lib/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
